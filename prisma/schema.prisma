generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("customer") // "customer" | "admin"
  createdAt DateTime @default(now())
  orders    Order[]
}

model Cake {
  id          String      @id @default(cuid())
  name        String
  description String
  category    String      // "Birthday" | "Anniversary" | "Kids" | "Classics"
  basePrice   Float
  imageUrl    String
  isAvailable Boolean     @default(true)
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  customerName    String
  customerPhone   String
  deliveryAddress String
  deliveryDate    DateTime
  deliverySlot    String      // "10am-1pm" | "1pm-4pm" | "4pm-7pm" | "7pm-10pm"
  paymentMethod   String      // "UPI" | "Card" | "COD"
  totalAmount     Float
  status          String      @default("placed") // "placed" | "confirmed" | "baking" | "out_for_delivery" | "delivered" | "cancelled"
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cakeId        String?
  cake          Cake?    @relation(fields: [cakeId], references: [id], onDelete: SetNull)
  cakeName      String
  size          String   // "0.5kg" | "1kg"
  customMessage String?
  quantity      Int
  unitPrice     Float
}

